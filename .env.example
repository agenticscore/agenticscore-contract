# Copy to .env. Never commit .env.

# Pays deploy gas and sends owner transactions. Use a fresh key, not your main wallet.
DEPLOYER_PRIVATE_KEY=

# Who owns the contract after deploy. Use a multisig (for example a Safe) on mainnet.
OWNER_ADDRESS=

# The backend address the contract trusts for the allowlist and the score.
VOUCHER_SIGNER_ADDRESS=

# The single metadata URL every NFT returns (ipfs://... or https://...).
METADATA_URI=

# Optional. Leave empty to use the public RPCs from hardhat.config.js.
BSC_RPC_URL=
BSC_TESTNET_RPC_URL=
